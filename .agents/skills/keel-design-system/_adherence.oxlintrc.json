{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/data/**",
              "components/feedback/**",
              "components/forms/**",
              "components/structure/**",
              "ui_kits/authoring-ui/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|numeric|mono|children|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: tone, numeric, mono, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:soft|type|harm|danger|ok|advice|orphan)$/]",
        "message": "<Badge> tone must be one of 'soft' | 'type' | 'harm' | 'danger' | 'ok' | 'advice' | 'orphan'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Breadcrumb'] > JSXAttribute > JSXIdentifier[name!=/^(?:type|id|onType|lastChanged|onViewChange|style|key|ref|className|style|children)$/]",
        "message": "<Breadcrumb> doesn't accept that prop. Declared props: type, id, onType, lastChanged, onViewChange, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|disabled|glyph|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, disabled, glyph, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|ghost|bare)$/]",
        "message": "<Button> variant must be one of 'primary' | 'ghost' | 'bare'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:md|sm)$/]",
        "message": "<Button> size must be one of 'md' | 'sm'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|title|rationale|desc|badges|jump|onClick|children|style|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: id, title, rationale, desc, badges, jump, onClick, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='CheckSet'] > JSXAttribute > JSXIdentifier[name!=/^(?:options|value|onToggle|style|key|ref|className|style|children)$/]",
        "message": "<CheckSet> doesn't accept that prop. Declared props: options, value, onToggle, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chip'] > JSXAttribute > JSXIdentifier[name!=/^(?:selected|variant|mono|children|key|ref|className|style|children)$/]",
        "message": "<Chip> doesn't accept that prop. Declared props: selected, variant, mono, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chip'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:facet|jump)$/]",
        "message": "<Chip> variant must be one of 'facet' | 'jump'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CoverageBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|percent|orphan|style|key|ref|className|style|children)$/]",
        "message": "<CoverageBar> doesn't accept that prop. Declared props: label, percent, orphan, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='DiffView'] > JSXAttribute > JSXIdentifier[name!=/^(?:file|patch|loading|style|key|ref|className|style|children)$/]",
        "message": "<DiffView> doesn't accept that prop. Declared props: file, patch, loading, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Dot'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|size|key|ref|className|style|children)$/]",
        "message": "<Dot> doesn't accept that prop. Declared props: tone, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='Dot'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:error|advice|ok|none)$/]",
        "message": "<Dot> tone must be one of 'error' | 'advice' | 'ok' | 'none'."
      },
      {
        "selector": "JSXOpeningElement[name.name='EditorCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:summary|open|hasError|onToggle|onRemove|children|style|key|ref|className|style|children)$/]",
        "message": "<EditorCard> doesn't accept that prop. Declared props: summary, open, hasError, onToggle, onRemove, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='EmptyState'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|top|style|key|ref|className|style|children)$/]",
        "message": "<EmptyState> doesn't accept that prop. Declared props: children, top, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='EntityHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:glyph|title|id|badges|actions|style|key|ref|className|style|children)$/]",
        "message": "<EntityHeader> doesn't accept that prop. Declared props: glyph, title, id, badges, actions, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ErrorSummary'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|title|items|style|key|ref|className|style|children)$/]",
        "message": "<ErrorSummary> doesn't accept that prop. Declared props: tone, title, items, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ErrorSummary'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:error|advice)$/]",
        "message": "<ErrorSummary> tone must be one of 'error' | 'advice'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FacetGroup'] > JSXAttribute > JSXIdentifier[name!=/^(?:key|label|options|key|ref|className|style|children)$/]",
        "message": "<FacetGroup> doesn't accept that prop. Declared props: key, label, options."
      },
      {
        "selector": "JSXOpeningElement[name.name='Field'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|hint|error|advice|guidance|reserveHint|children|style|key|ref|className|style|children)$/]",
        "message": "<Field> doesn't accept that prop. Declared props: label, hint, error, advice, guidance, reserveHint, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='GapChips'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|items|onPick|dashed|style|key|ref|className|style|children)$/]",
        "message": "<GapChips> doesn't accept that prop. Declared props: label, items, onPick, dashed, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:glyph|tone|title|key|ref|className|style|children)$/]",
        "message": "<IconButton> doesn't accept that prop. Declared props: glyph, tone, title."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:neutral|danger)$/]",
        "message": "<IconButton> tone must be one of 'neutral' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='RailRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|title|badges|selected|onClick|style|key|ref|className|style|children)$/]",
        "message": "<RailRow> doesn't accept that prop. Declared props: id, title, badges, selected, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='RiskBadge'] > JSXAttribute > JSXIdentifier[name!=/^(?:level|prefix|style|key|ref|className|style|children)$/]",
        "message": "<RiskBadge> doesn't accept that prop. Declared props: level, prefix, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='RiskBadge'] > JSXAttribute[name.name='level'] > Literal[value!=/^(?:critical|high|medium|low|info)$/]",
        "message": "<RiskBadge> level must be one of 'critical' | 'high' | 'medium' | 'low' | 'info'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SavedDialog'] > JSXAttribute > JSXIdentifier[name!=/^(?:file|message|show|repoUrl|onClose|style|key|ref|className|style|children)$/]",
        "message": "<SavedDialog> doesn't accept that prop. Declared props: file, message, show, repoUrl, onClose, style."
