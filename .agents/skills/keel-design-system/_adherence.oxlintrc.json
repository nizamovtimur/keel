      {
        "selector": "JSXOpeningElement[name.name='ScreenTabs'] > JSXAttribute > JSXIdentifier[name!=/^(?:screens|value|onChange|style|key|ref|className|style|children)$/]",
        "message": "<ScreenTabs> doesn't accept that prop. Declared props: screens, value, onChange, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SearchInput'] > JSXAttribute > JSXIdentifier[name!=/^(?:placeholder|key|ref|className|style|children)$/]",
        "message": "<SearchInput> doesn't accept that prop. Declared props: placeholder."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionBand'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|sub|as|count|children|style|key|ref|className|style|children)$/]",
        "message": "<SectionBand> doesn't accept that prop. Declared props: label, sub, as, count, children, style."
