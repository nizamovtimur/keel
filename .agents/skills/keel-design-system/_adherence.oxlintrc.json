      {
        "selector": "JSXOpeningElement[name.name='SectionBand'] > JSXAttribute[name.name='as'] > Literal[value!=/^(?:section|fieldset)$/]",
        "message": "<SectionBand> as must be one of 'section' | 'fieldset'."
